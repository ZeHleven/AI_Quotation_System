APP_NAME=Enterprise AI Middle Office
APP_VERSION=1.0.0
APP_ENV=development
STRICT_CONFIG=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./sql_app.db
DATABASE_STARTUP_WAIT_SECONDS=120
DATABASE_STARTUP_RETRY_INTERVAL_SECONDS=3
# Production should rely on Alembic. For a brand-new local SQLite sandbox, you may set these to true temporarily.
AUTO_CREATE_TABLES=false
STARTUP_COMPAT_MIGRATIONS=false
AUTO_RUN_DB_MIGRATIONS=true
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SYSTEM_ADMIN_USERNAME=admin
FEATURE_VITE_FRONTEND=false
FEATURE_DASHBOARD_QUOTE=false
FEATURE_CLIENT_INQUIRY=false
FEATURE_DASHBOARD_RESPONSE=false
FEATURE_EXECUTION=false
FEATURE_DASHBOARD_EXECUTION=false
FEATURE_MEETING_AI=false
FEATURE_AUDIO_TRANSCRIPTION=false
FEATURE_BUSINESS_LEDGER=false
FEATURE_COST_DB=false
FEATURE_COST_MEASUREMENT=false
FEATURE_PROJECT_COST_IMPORT=false
FEATURE_REQUIREMENT_STANDARDIZATION=false
FEATURE_BUDGET_PROJECTS=false
FEATURE_BUDGET_PRICING=false
FEATURE_BUDGET_PRICING_DRAFTS=false
FEATURE_BUDGET_PRICING_AI_ESTIMATE=false
FEATURE_ACCOUNT_QUOTAS=false
FEATURE_BIDDING_MVP=false
FEATURE_BIDDING_LLM_REVIEW=false
FEATURE_ENTERPRISE_PROFILE=false
FEATURE_NO_COST_DRAFT_CAPTURE=false
FEATURE_PROJECT_PROGRESS=false
FEATURE_DASHBOARD_PROJECT=false
FEATURE_DASHBOARD_BUSINESS_LITE=false
FEATURE_AGENT_ASSISTANTS=false
FEATURE_AGENT_DAILY_REVIEW=false
FEATURE_AGENT_LLM_EXPLANATION=true
FEATURE_PDF_TILE_VISION=true
PDF_TILE_VISION_MAX_TILES=4
AGENT_LLM_PROVIDER=rule
AGENT_LLM_PROMPT_VERSION=quote_review_explanation_v1
AGENT_LLM_TIMEOUT_SECONDS=20
BUDGET_PRICING_AI_PROVIDER=rule
BUDGET_PRICING_AI_MODEL=deepseek-v4-flash
BUDGET_PRICING_AI_PROMPT_VERSION=budget_pricing_ai_estimate_p2_2c1
BUDGET_PRICING_AI_TIMEOUT_SECONDS=45
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
BIDDING_LLM_PROVIDER=deepseek
BIDDING_LLM_MODEL=deepseek-v4-pro
BIDDING_LLM_TIMEOUT_SECONDS=0
BIDDING_LLM_MAX_OBJECTS=25
FEATURE_AGENT_MARKET_WEB_SEARCH=false
MARKET_SEARCH_PROVIDER=tavily
MARKET_SEARCH_API_KEY=
MARKET_SEARCH_ENDPOINT=https://api.tavily.com/search
MARKET_SEARCH_MAX_RESULTS=5
MARKET_SEARCH_TIMEOUT_SECONDS=10
AGENT_DAILY_REVIEW_TIMEZONE=Asia/Shanghai
AGENT_DAILY_REVIEW_RUN_TIME=18:30
AGENT_DAILY_REVIEW_MAX_JOBS=100
AGENT_DAILY_REVIEW_POLL_SECONDS=60
AGENT_DAILY_REVIEW_CATCHUP_MINUTES=120
RESPONSE_SLA_MINUTES=30
PUBLIC_ACCESS_ENABLED=false
ALLOW_SELF_REGISTRATION=false

ZHIPU_API_KEY=
WEBHOOK_SECRET=
RELOAD_SECRET=
N8N_WEBHOOK_URL_CALC=http://192.168.88.128:5678/webhook/budget-calc
N8N_WEBHOOK_URL_PUSH=http://192.168.88.128:5678/webhook/budget-push
RAG_SERVICE_URL=http://192.168.88.128:8001
RAG_RELOAD_TIMEOUT_SECONDS=900
DIFY_APP_VERSION=
DIFY_WORKFLOW_VERSION=
DIFY_PROMPT_VERSION=
DIFY_RELEASE_ID=
RAG_COLLECTION_ALIAS=enterprise_quotation_rag
TASK_QUEUE_MODE=local
CELERY_BROKER_URL=redis://192.168.88.128:6380/0
CELERY_RESULT_BACKEND=redis://192.168.88.128:6380/1
CELERY_WORKER_POOL=threads
CELERY_WORKER_CONCURRENCY=2
QUOTE_TASK_TIME_LIMIT_SECONDS=240
QUOTE_N8N_TIMEOUT_SECONDS=180
QUOTE_JOB_HEARTBEAT_INTERVAL_SECONDS=15
QUEUE_HEALTH_TIMEOUT_SECONDS=1.5
# When true, /health/ready also probes CentOS-side dependencies. Keep false for fast local dev.
READY_CHECK_EXTERNAL_SERVICES=false
OPS_PROBE_TIMEOUT_SECONDS=2
OPS_PROBE_ATTEMPTS=2
OPS_PROBE_RETRY_DELAY_SECONDS=0.3
OPS_STUCK_JOB_MINUTES=30
OPS_LOG_SCAN_LINES=800
OPS_LOG_MAX_FILES=6
OPS_LOG_LOOKBACK_MINUTES=180
OPS_LOG_CURRENT_MINUTES=30
# 运维告警推送（留空则静默不推送）
ALERT_DINGTALK_WEBHOOK=
ALERT_DEDUP_MINUTES=30
ALERT_RATE_LIMIT_COUNT=3
ALERT_RATE_LIMIT_WINDOW_MINUTES=5
ALERT_CHECK_INTERVAL_SECONDS=60
QUOTE_VISION_PROVIDER=dashscope
GLM_VISION_MODEL=glm-5v-turbo
GLM_VISION_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_DRAWING_AGENT_TIMEOUT_SECONDS=120
OPENAI_DRAWING_AGENT_MAX_VIEWS=24
OPENAI_DRAWING_AGENT_BATCH_SIZE=8
OPENAI_DRAWING_AGENT_INCLUDE_WHOLE_PAGE=true
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen-vl-max
DASHSCOPE_EVIDENCE_MODEL=qwen-vl-max
DASHSCOPE_BILL_SUMMARY_MODEL=qwen-vl-max
DASHSCOPE_TIMEOUT_SECONDS=120
DASHSCOPE_TEMPERATURE=0.2
DASHSCOPE_DRAWING_AGENT_MAX_VIEWS=24
DASHSCOPE_DRAWING_AGENT_BATCH_SIZE=8
DASHSCOPE_DRAWING_AGENT_INCLUDE_WHOLE_PAGE=true
DRAWING_LAYOUT_PLANNER_PROVIDER=dashscope
DRAWING_LAYOUT_PLANNER_MODEL=qwen-vl-max
DRAWING_LAYOUT_PLANNER_MAX_PAGES=3
DRAWING_REGION_CROP_MAX_REGIONS=24
DRAWING_CAD_VIEW_DETAIL_PLANNER_MODEL=qwen-vl-max
DRAWING_MATERIAL_REGION_PLANNER_MODEL=qwen-vl-max
DRAWING_MATERIAL_REGION_PLANNER_MAX_PAGES=2
DRAWING_MATERIAL_REGION_PLANNER_MAX_CAD_VIEWS=8
DRAWING_MATERIAL_REGION_PLANNER_MAX_REGIONS=32
DRAWING_CAD_VIEW_DETAIL_MAX_VIEWS=24
DRAWING_CAD_VIEW_DETAIL_MAX_REGIONS=48
DRAWING_HIGHRES_REGION_RENDER_ENABLED=true
DRAWING_HIGHRES_REGION_DEFAULT_SCALE=64
DRAWING_HIGHRES_REGION_MAX_SCALE=96
DRAWING_HIGHRES_REGION_MAX_PIXELS=32000000
DRAWING_HIGHRES_REGION_MIN_WIDTH_PX=1200
DRAWING_HIGHRES_REGION_MIN_HEIGHT_PX=300
DRAWING_HIGHRES_REGION_USE_FOR_OCR=false
PDFTOPPM_EXE=
FEATURE_PDF_DIRECT_ITEMIZATION=true
FEATURE_ACCOUNT_QUOTA_DRAFT_SYNC=false
PDF_ITEMIZATION_PROVIDER=glm
PDF_DIRECT_ITEMIZATION_MAX_IMAGES=40
MODEL_GATEWAY_TIMEOUT_SECONDS=20
MODEL_GATEWAY_FAILURE_THRESHOLD=3
MODEL_GATEWAY_CIRCUIT_RESET_SECONDS=60
MODEL_GATEWAY_COST_PER_1K_CHARS=0.0
MINIO_ENABLED=false
MINIO_ENDPOINT=192.168.88.128:9002
MINIO_ACCESS_KEY=quoteadmin
MINIO_SECRET_KEY=change-this-password
MINIO_SECURE=false
MINIO_BUCKET=quote-files
MINIO_PRESIGNED_EXPIRE_SECONDS=3600
MINIO_MAX_UPLOAD_MB=50
# RAG 检索质量评测（热更新后自动触发）
RAG_EVAL_ENABLED=true
RAG_EVAL_TOP_K=5
RAG_EVAL_WARN_HIT_RATE=0.70
RAG_EVAL_WARN_MRR=0.50
RAG_EVAL_REPORT_DIR=
# 登录接口限流（每 IP 每时间窗口最多 N 次，Redis 不可用时自动降级为内存）
LOGIN_RATE_LIMIT=10/5minutes

HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=192.168.88.128,192.168.0.0/16,192.168.88.0/24,localhost,127.0.0.1,127.0.0.0/8
CORS_ALLOW_ORIGINS=*
# Main material storage is the database. This file is only the legacy JSON import source.
LEGACY_MATERIALS_FILE=
# Backward-compatible alias for older deployments. Prefer LEGACY_MATERIALS_FILE for new env files.
MATERIALS_FILE=
