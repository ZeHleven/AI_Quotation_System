  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 128}},
      "XContentSha256": {"name": "X-Content-SHA256", "in": "header", "required": false, "schema": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1}},
      "IfNoneMatch": {"name": "If-None-Match", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1}},
      "LastEventId": {"name": "Last-Event-ID", "in": "header", "required": false, "schema": {"type": "string", "maxLength": 80}},
      "Page": {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "default": 1}},
      "PageSize": {"name": "page_size", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}},
      "ManifestIdQuery": {"name": "manifest_id", "in": "query", "required": false, "description": "省略时选择 Assessment 当前 Manifest；显式值只能属于该 Assessment", "schema": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"}},
      "DocumentTypeQuery": {"name": "document_type", "in": "query", "required": false, "schema": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"}},
      "DocumentParseStatusQuery": {"name": "parse_status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["not_requested", "queued", "running", "succeeded", "partial", "failed"]}},
      "IncludeDocumentVersions": {"name": "include_versions", "in": "query", "required": false, "schema": {"type": "boolean", "default": false}},
      "AssessmentId": {"name": "assessment_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 80}},
      "BatchId": {"name": "batch_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 80}},
      "FileId": {"name": "file_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 80}},
