# Copy this file to /opt/rag_service/.env on CentOS and replace every
# change-* value with the real production secret. Do not commit .env.

# RAG reload API
RELOAD_SECRET=change-me-rag-reload-secret

# Milvus internal MinIO credentials. Milvus and the internal minio service
# must use the same pair. For an existing deployment, copy the currently active
# values before restarting the compose stack.
MILVUS_MINIO_ACCESS_KEY=milvus-minio
MILVUS_MINIO_SECRET_KEY=change-this-password

# Quote attachment MinIO credentials.
QUOTE_MINIO_ROOT_USER=quoteadmin
QUOTE_MINIO_ROOT_PASSWORD=change-this-password

# Backup script configuration. Fill these when MySQL backups are required.
MYSQL_CONTAINER=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
N8N_CONTAINER=n8n
BACKUP_ROOT=/opt/rag_service/backups
