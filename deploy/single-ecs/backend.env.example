# Copy to /etc/ai-middle-office/backend.env on the target ECS, replace every
# placeholder from the approved secret store, then set root:root / 0600.
# Never commit or paste the real file.

AI_DATA_ROOT=/data/ai-middle-office

MILVUS_MINIO_ACCESS_KEY=replace-from-approved-secret-store
MILVUS_MINIO_SECRET_KEY=replace-from-approved-secret-store
QUOTE_MINIO_ROOT_USER=replace-from-approved-secret-store
QUOTE_MINIO_ROOT_PASSWORD=replace-from-approved-secret-store
RELOAD_SECRET=replace-from-approved-secret-store

# The N8N environment is deliberately separate because it contains the
# encryption key required to decrypt existing stored credentials.
N8N_ENV_FILE=/etc/ai-middle-office/n8n.env
