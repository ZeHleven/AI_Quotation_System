{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/planner.schema.json",
  "title": "Bid Assessment Planner Contracts v1",
  "description": "Plan proposal boundary derived from master spec sections 7.3-7.6 and 12.3.1.",
  "$defs": {
    "CoverageCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved", "missing", "unavailable", "not_assessed", "blocked_by_parent", "not_applicable", "stale"],
      "properties": {
        "resolved": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0},
        "not_assessed": {"type": "integer", "minimum": 0},
        "blocked_by_parent": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0},
        "stale": {"type": "integer", "minimum": 0}
      }
    },
    "ResolvedFactCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "partial", "conflicted"],
      "properties": {
        "supported": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "conflicted": {"type": "integer", "minimum": 0}
      }
    },
    "PlannerAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goal", "scope_id"],
      "properties": {
        "id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "goal": {"const": "bid_go_no_go"},
        "scope_id": {"$ref": "contracts.schema.json#/$defs/Id"}
      }
    },
    "DocumentInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "version_id"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 80},
        "status": {"type": "string", "minLength": 1, "maxLength": 40},
        "version_id": {"$ref": "contracts.schema.json#/$defs/Id"}
      }
    },
    "GateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status"],
      "properties": {
        "code": {"type": "string", "pattern": "^HG0[1-7]$"},
        "status": {"type": "string", "enum": ["pass", "fail", "unknown", "not_applicable"]}
      }
    },
    "TaskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_key", "status"],
      "properties": {
        "task_key": {"type": "string", "minLength": 1, "maxLength": 160},
        "status": {"$ref": "contracts.schema.json#/$defs/TaskStatus"}
      }
    },
    "PlanningLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_dynamic_tasks", "max_dependency_depth"],
      "properties": {
        "max_dynamic_tasks": {"const": 8},
        "max_dependency_depth": {"const": 3}
      }
    },
    "QuestionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_slot", "question_text", "impact", "priority"],
      "properties": {
        "fact_slot": {"type": "string", "minLength": 1, "maxLength": 160},
        "question_text": {"type": "string", "minLength": 1, "maxLength": 500},
        "impact": {"type": "string", "minLength": 1, "maxLength": 500},
        "priority": {"type": "string", "enum": ["critical", "important", "contextual"]}
      }
    },
    "PlannerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "bound_versions",
        "workflow_stage",
        "document_inventory",
        "fact_slot_summary",
        "gate_summary",
        "task_summary",
        "open_questions",
        "allowed_task_types",
        "planning_limits"
      ],
      "properties": {
        "assessment": {"$ref": "#/$defs/PlannerAssessment"},
        "run_kind": {"type": "string", "enum": ["preliminary", "deep", "reanalysis"]},
        "bound_versions": {"$ref": "contracts.schema.json#/$defs/VersionBinding"},
        "workflow_stage": {"type": "string", "minLength": 1, "maxLength": 80},
        "document_inventory": {
          "type": "array",
          "maxItems": 500,
          "items": {"$ref": "#/$defs/DocumentInventoryItem"}
        },
        "fact_slot_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coverage", "resolved_facts"],
          "properties": {
            "coverage": {"$ref": "#/$defs/CoverageCounts"},
            "resolved_facts": {"$ref": "#/$defs/ResolvedFactCounts"}
          }
        },
        "gate_summary": {
          "type": "array",
          "maxItems": 7,
          "items": {"$ref": "#/$defs/GateSummary"}
        },
        "task_summary": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/TaskSummary"}
        },
        "open_questions": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/QuestionCandidate"}
        },
        "allowed_task_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 49,
          "uniqueItems": true,
          "items": {"$ref": "task.schema.json#/$defs/TaskType"}
        },
        "planning_limits": {"$ref": "#/$defs/PlanningLimits"}
      }
    },
    "PlanProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "reason_codes",
        "add_tasks",
        "supersede_tasks",
        "questions",
        "expected_stage_after",
        "planner_confidence"
      ],
      "properties": {
        "proposal_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$"}
        },
        "add_tasks": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "task.schema.json#/$defs/TaskDefinition"}
        },
        "supersede_tasks": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "questions": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/QuestionCandidate"}
        },
        "expected_stage_after": {"type": "string", "minLength": 1, "maxLength": 80},
        "planner_confidence": {"type": "string", "enum": ["high", "medium", "low"]}
      }
    },
    "PlanValidationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "validated_hash"],
      "properties": {
        "status": {"const": "accepted"},
        "checks": {
          "type": "array",
          "minItems": 9,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "task_type_allowlist",
              "acyclic_dependencies",
              "scope_version_consistency",
              "tool_profile_permissions",
              "budget_limits",
              "max_8_dynamic_tasks",
              "max_dependency_depth_3",
              "hard_gate_ordering",
              "report_validation_ordering",
              "skill_binding_hash",
              "stage_sequence"
            ]
          }
        },
        "validated_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"}
      }
    },
    "PlanCommitEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generator_version",
        "validator_version",
        "task_registry_version",
        "task_registry_hash",
        "run_input_hash",
        "planner_input_hash",
        "proposal_hash",
        "planner_input",
        "proposal",
        "validation"
      ],
      "properties": {
        "schema": {"type": "string", "enum": ["bid.plan.commit.envelope.v1", "bid.plan.commit.envelope.v2"]},
        "generator_version": {"type": "string", "enum": ["bid-deterministic-bootstrap-planner-v1", "bid-deterministic-stage-planner-v2"]},
        "validator_version": {"type": "string", "enum": ["bid-plan-validator-v1", "bid-plan-validator-v2"]},
        "task_registry_version": {"type": "string", "minLength": 1, "maxLength": 160},
        "task_registry_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "task_catalog_ref": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}\\.json$"},
        "skill_catalog_ref": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}\\.json$"},
        "skill_catalog_version": {"type": "string", "minLength": 1, "maxLength": 160},
        "skill_catalog_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "stage": {"type": "string", "pattern": "^P[0-4]$"},
        "final_stage": {"type": "boolean"},
        "run_input_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "planner_input_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "proposal_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "planner_input": {"$ref": "#/$defs/PlannerInput"},
        "proposal": {"$ref": "#/$defs/PlanProposal"},
        "validation": {"$ref": "#/$defs/PlanValidationReceipt"}
      },
      "allOf": [
        {
          "if": {"properties": {"schema": {"const": "bid.plan.commit.envelope.v2"}}},
            "then": {
              "required": ["task_catalog_ref", "skill_catalog_ref", "skill_catalog_version", "skill_catalog_hash", "stage", "final_stage"],
              "properties": {
                "generator_version": {"const": "bid-deterministic-stage-planner-v2"},
                "validator_version": {"const": "bid-plan-validator-v2"},
                "planner_input": {
                  "allOf": [
                    {"$ref": "#/$defs/PlannerInput"},
                    {"required": ["run_kind"]}
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "generator_version": {"const": "bid-deterministic-bootstrap-planner-v1"},
                "validator_version": {"const": "bid-plan-validator-v1"}
              }
            }
        }
      ]
    }
  },
  "x-semantic-validations": {
    "validator": "plan.validate",
    "checks": [
      "task_type_allowlist",
      "acyclic_dependencies",
      "scope_version_consistency",
      "tool_profile_permissions",
      "budget_limits",
      "max_8_dynamic_tasks",
      "max_dependency_depth_3",
      "hard_gate_ordering",
      "report_validation_ordering"
    ]
  },
  "oneOf": [
    {"$ref": "#/$defs/PlannerInput"},
    {"$ref": "#/$defs/PlanProposal"},
    {"$ref": "#/$defs/PlanCommitEnvelope"}
  ]
}
