{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/contracts.schema.json",
  "title": "Qisheng Bid Assessment Agent Contract Bundle v1",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "UtcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^(sha256:)?[a-f0-9]{64}$"
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    },
    "NonnegativeDecimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    },
    "MoneyDecimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"
    },
    "RatioDecimalString": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]{1,6})?|1(\\.0{1,6})?)$"
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"$ref": "#/$defs/MoneyDecimalString"},
        "currency": {"type": "string", "enum": ["CNY"]}
      }
    },
    "ScenarioMoney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "base", "high", "currency"],
      "properties": {
        "low": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"},
        "base": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"},
        "high": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"},
        "currency": {"type": "string", "enum": ["CNY"]}
      }
    },
    "AssessmentLifecycleStatus": {
      "type": "string",
      "enum": ["active", "archived"]
    },
    "AssessmentBusinessStatus": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_files",
        "preparing",
        "awaiting_lot_selection",
        "preliminary_analyzing",
        "preliminary_ready",
        "awaiting_owner_input",
        "deep_analyzing",
        "validating",
        "deep_ready",
        "stale_input",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "UploadBatchStatus": {
      "type": "string",
      "enum": ["draft", "uploading", "ready", "committing", "committed", "abandoned", "expired", "failed"]
    },
    "AnalysisRunStatus": {
      "type": "string",
      "enum": ["created", "planning", "queued", "running", "waiting_input", "waiting_operation", "validating", "succeeded", "failed", "stale", "cancelled"]
    },
    "PlanRevisionStatus": {
      "type": "string",
      "enum": ["proposed", "validating", "committed", "rejected", "superseded"]
    },
    "TaskStatus": {
      "type": "string",
      "enum": ["blocked", "ready", "leased", "running", "waiting_operation", "waiting_input", "validating", "succeeded", "failed", "skipped", "stale", "cancelled"]
    },
    "ReportStatus": {
      "type": "string",
      "enum": ["draft", "generating", "validating", "rendered", "published", "failed", "cancelled", "superseded"]
    },
    "QuestionStatus": {
      "type": "string",
      "enum": ["candidate", "published", "answered", "expired", "withdrawn", "discarded", "superseded"]
    },
    "AsyncOperationStatus": {
      "type": "string",
      "enum": ["created", "submitted", "running", "succeeded", "failed", "cancelled", "timed_out"]
    },
    "SlotCoverageStatus": {
      "type": "string",
      "enum": ["not_assessed", "unavailable", "blocked_by_parent", "missing", "resolved", "not_applicable", "stale"]
    },
    "ResolvedFactStatus": {
      "type": "string",
      "enum": ["supported", "partial", "conflicted"]
    },
    "DecisionClass": {
      "type": "string",
      "enum": ["recommend", "conditional", "not_recommend", "insufficient"]
    },
    "InvestmentLevel": {
      "type": "string",
      "enum": ["stop", "low_cost_verification", "limited", "full"]
    },
    "ActionCode": {
      "type": "string",
      "enum": [
        "assessment.edit_metadata",
        "assessment.abandon_draft",
        "upload_batch.create",
        "upload_batch.resume",
        "upload_batch.commit",
        "upload_file.retry",
        "upload_file.remove_draft",
        "documents.append",
        "documents.replace",
        "documents.deactivate_in_next_manifest",
        "lot.select",
        "assessment.create_for_other_lot",
        "run.view_progress",
        "run.cancel",
        "run.retry_from_checkpoint",
        "run.create_from_latest_manifest",
        "questions.save_draft",
        "questions.submit_batch",
        "report.view",
        "report.download",
        "evidence.view",
        "versions.view",
        "versions.compare",
        "owner_override.record"
      ]
    },
    "VersionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "scope_id",
        "enterprise_snapshot_version",
        "rule_set_version",
        "fact_catalog_version",
        "prompt_bundle_version",
        "tool_registry_version",
        "model_profile_version",
        "formula_catalog_version",
        "evaluation_time"
      ],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/Id"},
        "scope_id": {"$ref": "#/$defs/Id"},
        "enterprise_snapshot_version": {"$ref": "#/$defs/Id"},
        "rule_set_version": {"$ref": "#/$defs/Id"},
        "fact_catalog_version": {"$ref": "#/$defs/Id"},
        "prompt_bundle_version": {"$ref": "#/$defs/Id"},
        "tool_registry_version": {"$ref": "#/$defs/Id"},
        "model_profile_version": {"$ref": "#/$defs/Id"},
        "formula_catalog_version": {"$ref": "#/$defs/Id"},
        "evaluation_time": {"$ref": "#/$defs/UtcDateTime"}
      }
    },
    "AllowedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "enabled", "requires_confirmation", "reason_code", "target"],
      "properties": {
        "code": {"$ref": "#/$defs/ActionCode"},
        "enabled": {"type": "boolean"},
        "requires_confirmation": {"type": "boolean"},
        "reason_code": {"type": ["string", "null"], "maxLength": 100},
        "target": {"type": "object"}
      }
    },
    "BlockingReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 100},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "ScopeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "lot_id", "lot_code", "lot_name", "scope_version"],
      "properties": {
        "scope_id": {"$ref": "#/$defs/Id"},
        "lot_id": {"$ref": "#/$defs/Id"},
        "lot_code": {"type": ["string", "null"], "maxLength": 100},
        "lot_name": {"type": "string", "minLength": 1, "maxLength": 300},
        "scope_version": {"type": "integer", "minimum": 1}
      }
    },
    "ManifestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "version", "document_count", "committed_at"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/Id"},
        "version": {"type": "integer", "minimum": 1},
        "document_count": {"type": "integer", "minimum": 0},
        "committed_at": {"$ref": "#/$defs/UtcDateTime"}
      }
    },
    "CommittedManifestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "version", "document_count", "manifest_hash", "committed_at"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/Id"},
        "version": {"type": "integer", "minimum": 1},
        "document_count": {"type": "integer", "minimum": 0},
        "manifest_hash": {"$ref": "#/$defs/Sha256"},
        "committed_at": {"$ref": "#/$defs/UtcDateTime"}
      }
    },
    "CommitOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "status", "status_url"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/Id"},
        "status": {"type": "string", "const": "accepted"},
        "status_url": {"type": "string", "pattern": "^/api/v1/bid-assessments/"}
      }
    },
    "CommittedUploadBatchSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "status", "row_version", "etag"],
      "properties": {
        "batch_id": {"$ref": "#/$defs/Id"},
        "status": {"type": "string", "const": "committed"},
        "row_version": {"type": "integer", "minimum": 2},
        "etag": {"type": "string", "pattern": "^\"bid-upload-batch:[A-Za-z0-9_.:-]+:[1-9][0-9]*:[a-f0-9]{12}\"$"}
      }
    },
    "CommitUploadBatchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "operation", "run", "assessment", "batch"],
      "properties": {
        "manifest": {"$ref": "#/$defs/CommittedManifestSummary"},
        "operation": {"$ref": "#/$defs/CommitOperation"},
        "run": {"type": "null"},
        "assessment": {"$ref": "#/$defs/AssessmentSnapshot"},
        "batch": {"$ref": "#/$defs/CommittedUploadBatchSummary"}
      }
    },
    "ActiveRunSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status", "run_kind", "input_manifest_id", "progress_url"],
      "properties": {
        "run_id": {"$ref": "#/$defs/Id"},
        "status": {"$ref": "#/$defs/AnalysisRunStatus"},
        "run_kind": {"type": "string", "enum": ["preliminary", "deep", "reanalysis"]},
        "input_manifest_id": {"$ref": "#/$defs/Id"},
        "progress_url": {"type": "string", "pattern": "^/api/v1/"}
      }
    },
    "ReportLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "version", "url"],
      "properties": {
        "report_id": {"$ref": "#/$defs/Id"},
        "version": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "pattern": "^/api/v1/"}
      }
    },
    "AssessmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "title",
        "client_name",
        "internal_note",
        "lifecycle_status",
        "business_status",
        "row_version",
        "scope",
        "current_manifest",
        "active_run",
        "latest_reports",
        "blocking_reason",
        "recommended_view",
        "primary_action",
        "allowed_actions",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "assessment_id": {"$ref": "#/$defs/Id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "client_name": {"type": "string", "minLength": 1, "maxLength": 300},
        "internal_note": {"type": ["string", "null"], "maxLength": 2000},
        "lifecycle_status": {"$ref": "#/$defs/AssessmentLifecycleStatus"},
        "business_status": {"$ref": "#/$defs/AssessmentBusinessStatus"},
        "row_version": {"type": "integer", "minimum": 1},
        "scope": {"oneOf": [{"$ref": "#/$defs/ScopeSnapshot"}, {"type": "null"}]},
        "current_manifest": {"oneOf": [{"$ref": "#/$defs/ManifestSummary"}, {"type": "null"}]},
        "active_run": {"oneOf": [{"$ref": "#/$defs/ActiveRunSummary"}, {"type": "null"}]},
        "latest_reports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preliminary", "deep"],
          "properties": {
            "preliminary": {"oneOf": [{"$ref": "#/$defs/ReportLink"}, {"type": "null"}]},
            "deep": {"oneOf": [{"$ref": "#/$defs/ReportLink"}, {"type": "null"}]}
          }
        },
        "blocking_reason": {"oneOf": [{"$ref": "#/$defs/BlockingReason"}, {"type": "null"}]},
        "recommended_view": {"type": "string", "minLength": 1, "maxLength": 80},
        "primary_action": {"oneOf": [{"$ref": "#/$defs/ActionCode"}, {"type": "null"}]},
        "allowed_actions": {"type": "array", "items": {"$ref": "#/$defs/AllowedAction"}},
        "created_at": {"$ref": "#/$defs/UtcDateTime"},
        "updated_at": {"$ref": "#/$defs/UtcDateTime"}
      }
    },
    "UploadLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_file_bytes", "max_batch_bytes", "accepted_extensions"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1},
        "max_file_bytes": {"type": "integer", "minimum": 1},
        "max_batch_bytes": {"type": "integer", "minimum": 1},
        "accepted_extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}
      }
    },
    "UploadBatchFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_file_id", "client_file_id", "filename", "relative_path", "operation", "replace_document_id", "size_bytes", "sha256", "mime_type", "status", "error_code", "row_version", "etag"],
      "properties": {
        "batch_file_id": {"$ref": "#/$defs/Id"},
        "client_file_id": {"$ref": "#/$defs/Id"},
        "filename": {"type": "string", "minLength": 1, "maxLength": 500},
        "relative_path": {"type": ["string", "null"], "maxLength": 1000},
        "operation": {"type": "string", "enum": ["add", "replace"]},
        "replace_document_id": {"oneOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "mime_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "status": {"type": "string", "enum": ["receiving", "inspecting", "ready", "rejected", "failed"]},
        "error_code": {"type": ["string", "null"], "maxLength": 100},
        "row_version": {"type": "integer", "minimum": 1},
        "etag": {"type": "string", "pattern": "^\"bid-upload-file:[A-Za-z0-9_.:-]+:[1-9][0-9]*\"$"}
      }
    },
    "UploadBatchSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "assessment_id", "purpose", "status", "base_manifest_id", "abandon_reason", "abandoned_at", "cleanup_after", "cleanup_completed_at", "row_version", "limits", "files", "deactivations", "validation", "expires_at"],
      "properties": {
        "batch_id": {"$ref": "#/$defs/Id"},
        "assessment_id": {"$ref": "#/$defs/Id"},
        "purpose": {"type": "string", "enum": ["initial", "change"]},
        "status": {"$ref": "#/$defs/UploadBatchStatus"},
        "base_manifest_id": {"oneOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]},
        "abandon_reason": {"type": ["string", "null"], "maxLength": 500},
        "abandoned_at": {"oneOf": [{"$ref": "#/$defs/UtcDateTime"}, {"type": "null"}]},
        "cleanup_after": {"oneOf": [{"$ref": "#/$defs/UtcDateTime"}, {"type": "null"}]},
        "cleanup_completed_at": {"oneOf": [{"$ref": "#/$defs/UtcDateTime"}, {"type": "null"}]},
        "row_version": {"type": "integer", "minimum": 1},
        "limits": {"$ref": "#/$defs/UploadLimits"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/UploadBatchFile"}},
        "deactivations": {"type": "array", "items": {"$ref": "#/$defs/Id"}},
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["can_commit", "blocking_errors", "warnings"],
          "properties": {
            "can_commit": {"type": "boolean"},
            "blocking_errors": {"type": "array", "items": {"type": "string", "maxLength": 300}},
            "warnings": {"type": "array", "items": {"type": "string", "maxLength": 300}}
          }
        },
        "expires_at": {"$ref": "#/$defs/UtcDateTime"}
      }
    },
    "DocumentVersionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "version_no", "filename", "size_bytes", "mime_type", "sha256_prefix", "created_at", "detail_url", "download_url"],
      "properties": {
        "version_id": {"$ref": "#/$defs/Id"},
        "version_no": {"type": "integer", "minimum": 1},
        "filename": {"type": "string", "minLength": 1, "maxLength": 500},
        "size_bytes": {"type": "integer", "minimum": 1},
        "mime_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "sha256_prefix": {"type": "string", "pattern": "^[a-f0-9]{12}$"},
        "created_at": {"$ref": "#/$defs/UtcDateTime"},
        "detail_url": {"type": "string", "pattern": "^/api/v1/bid-document-versions/"},
        "download_url": {"type": "string", "pattern": "^/api/v1/bid-document-versions/"}
      }
    },
    "DocumentParseQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "score", "page_count", "sheet_count", "ocr_status", "low_quality_locations"],
      "properties": {
        "grade": {"type": "string", "enum": ["high", "medium", "low"]},
        "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "page_count": {"type": ["integer", "null"], "minimum": 0},
        "sheet_count": {"type": ["integer", "null"], "minimum": 0},
        "ocr_status": {"type": "string", "enum": ["not_applicable", "not_run", "succeeded", "partial", "failed"]},
        "low_quality_locations": {"type": "array", "items": {"type": "string", "maxLength": 200}}
      }
    },
    "DocumentWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]{1,80}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500},
        "details": {"type": "object"}
      }
    },
    "DocumentReplacementChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_version_id", "next_version_id", "latest_version_id", "visible_version_count"],
      "properties": {
        "previous_version_id": {"oneOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]},
        "next_version_id": {"oneOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]},
        "latest_version_id": {"$ref": "#/$defs/Id"},
        "visible_version_count": {"type": "integer", "minimum": 1}
      }
    },
    "DocumentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "logical_name", "document_type", "role", "order_no", "selected_version", "current_version", "parse_status", "parse_quality", "is_in_current_manifest", "replacement_chain", "warnings", "versions"],
      "properties": {
        "document_id": {"$ref": "#/$defs/Id"},
        "logical_name": {"type": "string", "minLength": 1, "maxLength": 500},
        "document_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 64},
        "order_no": {"type": "integer", "minimum": 0},
        "selected_version": {"$ref": "#/$defs/DocumentVersionSummary"},
        "current_version": {"oneOf": [{"$ref": "#/$defs/DocumentVersionSummary"}, {"type": "null"}]},
        "parse_status": {"type": "string", "enum": ["not_requested", "queued", "running", "succeeded", "partial", "failed"]},
        "parse_quality": {"oneOf": [{"$ref": "#/$defs/DocumentParseQuality"}, {"type": "null"}]},
        "is_in_current_manifest": {"type": "boolean"},
        "replacement_chain": {"$ref": "#/$defs/DocumentReplacementChain"},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/DocumentWarning"}},
        "versions": {"oneOf": [{"type": "array", "items": {"$ref": "#/$defs/DocumentVersionSummary"}}, {"type": "null"}]}
      }
    },
    "DocumentManifestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "version", "document_count", "committed_at", "is_current"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/Id"},
        "version": {"type": "integer", "minimum": 1},
        "document_count": {"type": "integer", "minimum": 0},
        "committed_at": {"$ref": "#/$defs/UtcDateTime"},
        "is_current": {"type": "boolean"}
      }
    },
    "DocumentPageResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "data", "error", "request_id", "total", "page", "page_size", "manifest", "current_manifest_id", "manifest_selection", "filters", "include_versions"],
      "properties": {
        "code": {"type": "integer", "const": 200},
        "message": {"type": "string", "maxLength": 500},
        "data": {"type": "array", "items": {"$ref": "#/$defs/DocumentSummary"}},
        "error": {"type": "null"},
        "request_id": {"$ref": "#/$defs/Id"},
        "total": {"type": "integer", "minimum": 0},
        "page": {"type": "integer", "minimum": 1},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 100},
        "manifest": {"oneOf": [{"$ref": "#/$defs/DocumentManifestSummary"}, {"type": "null"}]},
        "current_manifest_id": {"oneOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]},
        "manifest_selection": {"type": "string", "enum": ["current", "explicit"]},
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_type", "parse_status"],
          "properties": {
            "document_type": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
            "parse_status": {"type": ["string", "null"], "enum": ["not_requested", "queued", "running", "succeeded", "partial", "failed", null]}
          }
        },
        "include_versions": {"type": "boolean"}
      }
    },
    "UploadAcceptedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_file_id", "client_file_id", "filename", "status", "size_bytes", "sha256", "row_version", "duplicate_of"],
      "properties": {
        "batch_file_id": {"$ref": "#/$defs/Id"},
        "client_file_id": {"$ref": "#/$defs/Id"},
        "filename": {"type": "string", "minLength": 1, "maxLength": 500},
        "status": {"type": "string", "enum": ["inspecting", "ready"]},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "row_version": {"type": "integer", "minimum": 1},
        "duplicate_of": {"oneOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]}
      }
    },
    "UploadFileBatchSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "row_version", "can_commit"],
      "properties": {
        "batch_id": {"$ref": "#/$defs/Id"},
        "row_version": {"type": "integer", "minimum": 1},
        "can_commit": {"type": "boolean"}
      }
    },
    "UploadFileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "batch"],
      "properties": {
        "file": {"$ref": "#/$defs/UploadAcceptedFile"},
        "batch": {"$ref": "#/$defs/UploadFileBatchSummary"}
      }
    },
