{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/model-execution.schema.json",
  "title": "Bid Assessment Phase 4A-2 Model Execution v1",
  "$defs": {
    "ReasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$"}
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "locator"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "locator": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "TaskAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_type", "tool_call_id", "tool_name", "arguments", "reason_codes"],
          "properties": {
            "action_type": {"const": "request_tool"},
            "tool_call_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,80}$"},
            "tool_name": {"$ref": "tools.schema.json#/$defs/ToolName"},
            "arguments": {"type": "object"},
            "reason_codes": {"$ref": "#/$defs/ReasonCodes"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_type", "candidates", "reason_codes"],
          "properties": {
            "action_type": {"const": "submit_fact_candidates"},
            "candidates": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "fact.schema.json#/$defs/FactAssertionCandidate"}},
            "reason_codes": {"$ref": "#/$defs/ReasonCodes"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_type", "candidates", "reason_codes"],
          "properties": {
            "action_type": {"const": "submit_claim_candidates"},
            "candidates": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "model-roles.schema.json#/$defs/ClaimCandidate"}},
            "reason_codes": {"$ref": "#/$defs/ReasonCodes"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_type", "questions", "reason_codes"],
          "properties": {
            "action_type": {"const": "request_task_input"},
            "questions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "planner.schema.json#/$defs/QuestionCandidate"}},
            "reason_codes": {"$ref": "#/$defs/ReasonCodes"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_type", "completion_summary", "output_candidate", "reason_codes"],
          "properties": {
            "action_type": {"const": "finish"},
            "completion_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
            "output_candidate": {"oneOf": [{"type": "object"}, {"type": "null"}]},
            "reason_codes": {"$ref": "#/$defs/ReasonCodes"}
          }
        }
      ]
    },
    "LocalAgentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_id", "task_id", "task_attempt_id", "fencing_token", "task_contract_hash", "skill_binding_hash", "phase", "action_seq", "observed_model_result_refs", "observed_tool_result_refs", "candidate_refs", "missing_slots", "outstanding_operation_ref", "stop_reason"],
      "properties": {
        "schema": {"const": "bid.local_agent.state.v1"},
        "run_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "task_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "task_attempt_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "fencing_token": {"type": "integer", "minimum": 1},
        "task_contract_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "skill_binding_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "phase": {"type": "string", "enum": ["hydrate", "await_model", "await_tool", "candidate_ready", "input_candidate_ready", "finish_ready", "stopped"]},
        "action_seq": {"type": "integer", "minimum": 0},
        "observed_model_result_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^model-result:[A-Za-z0-9][A-Za-z0-9_.:-]*$", "maxLength": 512}},
        "observed_tool_result_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^tool-result:[A-Za-z0-9][A-Za-z0-9_.:-]*$", "maxLength": 512}},
        "candidate_refs": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "pattern": "^model-result:[A-Za-z0-9][A-Za-z0-9_.:-]*$", "maxLength": 512}},
        "missing_slots": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "outstanding_operation_ref": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]},
        "stop_reason": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 100}, {"type": "null"}]}
      }
    },
    "ModelRequestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "model_call_id", "assessment_id", "run_id", "task_id", "task_attempt_id", "fencing_token", "action_seq", "logical_role", "provider_ref", "model_ref", "prompt_role", "action_schema", "context_manifest_id", "context_manifest_hash", "checkpoint_id", "checkpoint_state_hash", "task_contract_hash", "model_profile_hash", "model_route_hash", "prompt_bundle_hash", "input_token_limit", "output_token_limit", "cost_microunits_limit", "timeout_seconds"],
      "properties": {
        "schema": {"const": "bid.model.request.v1"},
        "model_call_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "assessment_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "run_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "task_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "task_attempt_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "fencing_token": {"type": "integer", "minimum": 1},
        "action_seq": {"type": "integer", "minimum": 1},
        "logical_role": {"$ref": "context.schema.json#/$defs/ModelRole"},
        "provider_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "prompt_role": {"type": "string", "minLength": 1, "maxLength": 128},
        "action_schema": {"const": "bid.task.action.v1"},
        "context_manifest_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "context_manifest_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "checkpoint_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "checkpoint_state_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "task_contract_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "model_profile_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "model_route_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "prompt_bundle_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "input_token_limit": {"type": "integer", "minimum": 1, "maximum": 32000},
        "output_token_limit": {"type": "integer", "minimum": 1, "maximum": 32000},
        "cost_microunits_limit": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 900}
      }
    },
    "ModelCallClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_call_id", "model_call_attempt_id", "worker_id", "fencing_token", "lease_until", "provider_ref", "model_ref", "replay_policy", "provider_request_id", "request_envelope"],
      "properties": {
        "model_call_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "model_call_attempt_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "worker_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "fencing_token": {"type": "integer", "minimum": 1},
        "lease_until": {"$ref": "contracts.schema.json#/$defs/UtcDateTime"},
        "provider_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "replay_policy": {"type": "string", "enum": ["safe_idempotent", "reconcile_required", "no_replay"]},
        "provider_request_id": {"type": "string", "minLength": 1, "maxLength": 191},
        "request_envelope": {"$ref": "#/$defs/ModelRequestEnvelope"}
      }
    },
    "ModelProviderResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "usage", "finish_reason", "provider_receipt_id", "actual_cost_microunits"],
      "properties": {
        "action": {"$ref": "#/$defs/TaskAction"},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0}
          }
        },
        "finish_reason": {"type": "string", "minLength": 1, "maxLength": 64},
        "provider_receipt_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 191}, {"type": "null"}]},
        "actual_cost_microunits": {"type": "integer", "minimum": 0}
      }
    },
    "ModelResultReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_call_id", "model_result_id", "operation_id", "result_hash", "action", "duplicate"],
      "properties": {
        "model_call_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "model_result_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "operation_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "result_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "action": {"$ref": "#/$defs/TaskAction"},
        "duplicate": {"type": "boolean"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/TaskAction"},
    {"$ref": "#/$defs/LocalAgentState"},
    {"$ref": "#/$defs/ModelRequestEnvelope"},
    {"$ref": "#/$defs/ModelCallClaim"},
    {"$ref": "#/$defs/ModelProviderResult"},
    {"$ref": "#/$defs/ModelResultReceipt"}
  ]
}
