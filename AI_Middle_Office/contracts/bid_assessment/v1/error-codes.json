{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "bid-assessment-v1",
  "stability_rule": "codes_are_append_only_and_semantics_are_immutable",
  "errors": [
    {"code": "BID_REQUEST_MALFORMED", "domain": "common", "http_status": 400, "retryable": false, "summary": "请求格式无法解析"},
    {"code": "BID_REQUEST_VALIDATION_FAILED", "domain": "common", "http_status": 422, "retryable": false, "summary": "请求字段或业务输入校验失败"},
    {"code": "BID_AUTHENTICATION_REQUIRED", "domain": "common", "http_status": 401, "retryable": false, "summary": "需要重新认证"},
    {"code": "BID_PERMISSION_DENIED", "domain": "common", "http_status": 403, "retryable": false, "summary": "已认证但无模块权限"},
    {"code": "BID_RESOURCE_NOT_FOUND", "domain": "common", "http_status": 404, "retryable": false, "summary": "资源不存在或不可见"},
    {"code": "BID_PRECONDITION_REQUIRED", "domain": "common", "http_status": 428, "retryable": false, "summary": "必须提供 If-Match"},
    {"code": "BID_RESOURCE_VERSION_MISMATCH", "domain": "common", "http_status": 412, "retryable": false, "summary": "资源版本已经变化"},
    {"code": "BID_IDEMPOTENCY_IN_PROGRESS", "domain": "common", "http_status": 409, "retryable": true, "summary": "相同幂等请求仍在处理"},
    {"code": "BID_IDEMPOTENCY_KEY_REUSED", "domain": "common", "http_status": 409, "retryable": false, "summary": "幂等键被用于不同请求"},
    {"code": "BID_ASSESSMENT_STATE_CONFLICT", "domain": "assessment", "http_status": 409, "retryable": false, "summary": "Assessment 当前状态不允许操作"},
    {"code": "BID_ACTIVE_RUN_EXISTS", "domain": "run", "http_status": 409, "retryable": false, "summary": "Assessment 已有活跃 Run"},
    {"code": "BID_RUN_INPUT_NOT_READY", "domain": "run", "http_status": 409, "retryable": false, "summary": "Run 输入尚未准备完成"},
    {"code": "BID_RUN_ALREADY_EXISTS_FOR_INPUT", "domain": "run", "http_status": 409, "retryable": false, "summary": "完全相同输入已存在 Run"},
    {"code": "BID_RUN_INPUT_STALE", "domain": "run", "http_status": 409, "retryable": false, "summary": "Run 输入已经过期"},
    {"code": "BID_RUN_NOT_RETRYABLE", "domain": "run", "http_status": 409, "retryable": false, "summary": "Run 不满足重试条件"},
    {"code": "BID_UPLOAD_BATCH_ALREADY_OPEN", "domain": "upload", "http_status": 409, "retryable": false, "summary": "已有可恢复的开放上传批次"},
    {"code": "BID_UPLOAD_BATCH_NOT_READY", "domain": "upload", "http_status": 409, "retryable": false, "summary": "上传批次尚不能提交"},
    {"code": "BID_UPLOAD_BATCH_ALREADY_COMMITTED", "domain": "upload", "http_status": 409, "retryable": false, "summary": "上传批次已经提交"},
    {"code": "BID_UPLOAD_BATCH_ALREADY_ABANDONED", "domain": "upload", "http_status": 409, "retryable": false, "summary": "上传批次已经放弃"},
    {"code": "BID_BASE_MANIFEST_STALE", "domain": "upload", "http_status": 409, "retryable": false, "summary": "资料变更批次的基础 Manifest 已过期"},
    {"code": "BID_UPLOAD_DEACTIVATION_NOT_ALLOWED", "domain": "upload", "http_status": 409, "retryable": false, "summary": "当前批次不是可登记停用操作的 change 批次"},
    {"code": "BID_UPLOAD_DEACTIVATION_TARGET_INVALID", "domain": "upload", "http_status": 409, "retryable": false, "summary": "停用目标不属于批次基础 Manifest"},
    {"code": "BID_UPLOAD_DEACTIVATION_CONFLICT", "domain": "upload", "http_status": 409, "retryable": false, "summary": "文档已使用不同原因登记停用"},
    {"code": "BID_EXPECTED_FILE_COUNT_MISMATCH", "domain": "upload", "http_status": 409, "retryable": false, "summary": "提交时文件数量与预期不一致"},
    {"code": "BID_EXPECTED_DEACTIVATION_COUNT_MISMATCH", "domain": "upload", "http_status": 409, "retryable": false, "summary": "提交时停用操作数量与预期不一致"},
    {"code": "BID_UPLOAD_BATCH_MERGE_CONFLICT", "domain": "upload", "http_status": 409, "retryable": false, "summary": "新增、替换和停用操作无法形成有效 Manifest"},
    {"code": "BID_UPLOAD_CLIENT_FILE_CONFLICT", "domain": "upload", "http_status": 409, "retryable": false, "summary": "同一客户端文件标识已绑定不同内容或元数据"},
    {"code": "BID_FILE_TOO_LARGE", "domain": "upload", "http_status": 413, "retryable": false, "summary": "单文件超过配置上限"},
    {"code": "BID_BATCH_TOO_LARGE", "domain": "upload", "http_status": 413, "retryable": false, "summary": "上传批次超过配置上限"},
    {"code": "BID_FILE_TYPE_UNSUPPORTED", "domain": "upload", "http_status": 415, "retryable": false, "summary": "文件类型不受支持"},
    {"code": "BID_FILE_CONTENT_INVALID", "domain": "upload", "http_status": 422, "retryable": false, "summary": "文件损坏、加密或类型伪装"},
    {"code": "BID_REPLACEMENT_TARGET_INVALID", "domain": "upload", "http_status": 409, "retryable": false, "summary": "替换目标不是当前可见逻辑文档"},
    {"code": "BID_LOT_CANDIDATES_NOT_READY", "domain": "lot", "http_status": 409, "retryable": true, "summary": "标段候选尚未生成"},
    {"code": "BID_LOT_NOT_IN_MANIFEST", "domain": "lot", "http_status": 422, "retryable": false, "summary": "标段候选不属于指定 Manifest"},
    {"code": "BID_LOT_SCOPE_ALREADY_BOUND", "domain": "lot", "http_status": 409, "retryable": false, "summary": "Assessment 已绑定其他标段"},
    {"code": "BID_QUESTION_ROUND_ALREADY_ANSWERED", "domain": "question", "http_status": 409, "retryable": false, "summary": "问题轮次已经提交答案"},
    {"code": "BID_QUESTION_ROUND_SUPERSEDED", "domain": "question", "http_status": 409, "retryable": false, "summary": "问题轮次已被新输入或新 Run 取代"},
    {"code": "BID_ANSWER_SCHEMA_MISMATCH", "domain": "question", "http_status": 422, "retryable": false, "summary": "答案不符合问题 Schema"},
    {"code": "BID_REPORT_NOT_PUBLISHED", "domain": "report", "http_status": 404, "retryable": true, "summary": "报告尚未发布或不可见"},
    {"code": "BID_REPORT_ARTIFACT_UNAVAILABLE", "domain": "report", "http_status": 503, "retryable": true, "summary": "报告工件暂时不可读取"},
    {"code": "BID_REPORT_SCOPE_MISMATCH", "domain": "delta", "http_status": 422, "retryable": false, "summary": "报告不属于相同 Assessment 和 Scope"},
    {"code": "BID_STORAGE_UNAVAILABLE", "domain": "dependency", "http_status": 503, "retryable": true, "summary": "对象存储暂时不可用"},
    {"code": "BID_QUEUE_UNAVAILABLE", "domain": "dependency", "http_status": 503, "retryable": true, "summary": "任务队列暂时不可用"},
    {"code": "BID_RATE_LIMITED", "domain": "rate_limit", "http_status": 429, "retryable": true, "summary": "请求超过速率或并发上限"}
  ]
}
