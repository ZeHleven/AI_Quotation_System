{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "bid-assessment-v1",
  "state_machines": {
    "assessment_lifecycle": {
      "states": ["active", "archived"],
      "terminal_states": ["archived"],
      "transitions": {
        "active": ["archived"],
        "archived": []
      }
    },
    "assessment_business": {
      "states": [
        "draft",
        "awaiting_files",
        "preparing",
        "awaiting_lot_selection",
        "preliminary_analyzing",
        "preliminary_ready",
        "awaiting_owner_input",
        "deep_analyzing",
        "validating",
        "deep_ready",
        "stale_input",
        "failed",
        "cancelled",
        "superseded"
      ],
      "terminal_states": ["superseded"],
      "transitions": {
        "draft": ["awaiting_files", "cancelled"],
        "awaiting_files": ["preparing", "cancelled"],
        "preparing": ["awaiting_files", "awaiting_lot_selection", "preliminary_analyzing", "failed", "stale_input", "cancelled"],
        "awaiting_lot_selection": ["awaiting_files", "preparing", "preliminary_analyzing", "stale_input", "cancelled"],
        "preliminary_analyzing": ["awaiting_files", "preparing", "preliminary_ready", "awaiting_owner_input", "failed", "stale_input", "cancelled"],
        "preliminary_ready": ["awaiting_files", "preparing", "deep_analyzing", "awaiting_owner_input", "stale_input", "superseded", "cancelled"],
        "awaiting_owner_input": ["awaiting_files", "preparing", "preliminary_analyzing", "deep_analyzing", "stale_input", "cancelled"],
        "deep_analyzing": ["awaiting_files", "preparing", "validating", "awaiting_owner_input", "failed", "stale_input", "cancelled"],
        "validating": ["awaiting_files", "preparing", "deep_ready", "deep_analyzing", "failed", "stale_input", "cancelled"],
        "deep_ready": ["awaiting_files", "preparing", "stale_input", "superseded"],
        "stale_input": ["awaiting_files", "preparing", "superseded", "cancelled"],
        "failed": ["awaiting_files", "preparing", "cancelled"],
        "cancelled": ["preparing", "awaiting_files", "superseded"],
        "superseded": []
      }
    },
    "upload_batch": {
      "states": ["draft", "uploading", "ready", "committing", "committed", "abandoned", "expired", "failed"],
      "terminal_states": ["committed", "abandoned", "expired", "failed"],
      "transitions": {
        "draft": ["uploading", "abandoned", "expired"],
        "uploading": ["ready", "abandoned", "expired"],
        "ready": ["uploading", "committing", "committed", "abandoned", "expired"],
        "committing": ["ready", "committed", "failed"],
        "committed": [],
        "abandoned": [],
        "expired": [],
        "failed": []
      }
    },
    "analysis_run": {
      "states": ["created", "planning", "queued", "running", "waiting_input", "waiting_operation", "validating", "succeeded", "failed", "stale", "cancelled"],
      "terminal_states": ["succeeded", "stale", "cancelled"],
      "conditional_terminal_states": {"failed": "retryable=false"},
      "transitions": {
        "created": ["planning", "cancelled", "stale", "failed"],
        "planning": ["queued", "cancelled", "stale", "failed"],
        "queued": ["running", "cancelled", "stale", "failed"],
        "running": ["planning", "waiting_input", "waiting_operation", "validating", "succeeded", "failed", "stale", "cancelled"],
        "waiting_input": ["queued", "stale", "cancelled"],
        "waiting_operation": ["queued", "failed", "stale", "cancelled"],
        "validating": ["queued", "succeeded", "failed", "stale", "cancelled"],
        "succeeded": [],
        "failed": ["queued", "stale", "cancelled"],
        "stale": [],
        "cancelled": []
      }
    },
    "plan_revision": {
      "states": ["proposed", "validating", "committed", "rejected", "superseded"],
      "terminal_states": ["rejected", "superseded"],
      "transitions": {
        "proposed": ["validating"],
        "validating": ["committed", "rejected"],
        "committed": ["superseded"],
        "rejected": [],
        "superseded": []
      }
    },
    "task": {
      "states": ["blocked", "ready", "leased", "running", "waiting_operation", "waiting_input", "validating", "succeeded", "failed", "skipped", "stale", "cancelled"],
      "terminal_states": ["succeeded", "skipped", "stale", "cancelled"],
      "transitions": {
        "blocked": ["ready", "skipped", "stale", "cancelled"],
        "ready": ["leased", "skipped", "stale", "cancelled"],
        "leased": ["running", "ready", "cancelled"],
        "running": ["ready", "waiting_operation", "waiting_input", "validating", "succeeded", "failed", "stale", "cancelled"],
        "waiting_operation": ["ready", "failed", "stale", "cancelled"],
        "waiting_input": ["ready", "stale", "cancelled"],
        "validating": ["ready", "succeeded", "failed", "stale", "cancelled"],
        "succeeded": [],
        "failed": ["ready", "cancelled"],
        "skipped": [],
        "stale": [],
        "cancelled": []
      }
    },
    "report": {
      "states": ["draft", "generating", "validating", "rendered", "published", "failed", "cancelled", "superseded"],
      "terminal_states": ["failed", "cancelled", "superseded"],
      "transitions": {
        "draft": ["generating", "cancelled"],
        "generating": ["validating", "failed", "cancelled"],
        "validating": ["rendered", "failed", "cancelled"],
        "rendered": ["published", "failed"],
        "published": ["superseded"],
        "failed": [],
        "cancelled": [],
        "superseded": []
      }
    },
    "question": {
      "states": ["candidate", "published", "answered", "expired", "withdrawn", "discarded", "superseded"],
      "terminal_states": ["expired", "withdrawn", "discarded", "superseded"],
      "transitions": {
        "candidate": ["published", "discarded"],
        "published": ["answered", "expired", "withdrawn"],
        "answered": ["superseded"],
        "expired": [],
        "withdrawn": [],
        "discarded": [],
        "superseded": []
      }
    },
    "async_operation": {
      "states": ["created", "submitted", "running", "succeeded", "failed", "cancelled", "timed_out"],
      "terminal_states": ["succeeded", "failed", "cancelled"],
      "transitions": {
        "created": ["submitted", "cancelled"],
        "submitted": ["running", "cancelled", "timed_out"],
        "running": ["succeeded", "failed", "cancelled", "timed_out"],
        "succeeded": [],
        "failed": [],
        "cancelled": [],
        "timed_out": ["submitted", "failed"]
      }
    },
    "run_validation": {
      "states": ["requested", "leased", "running", "passed", "failed", "stale", "cancelled"],
      "terminal_states": ["passed", "failed", "stale", "cancelled"],
      "transitions": {
        "requested": ["leased", "cancelled"],
        "leased": ["running", "requested", "cancelled"],
        "running": ["requested", "passed", "failed", "stale", "cancelled"],
        "passed": [],
        "failed": [],
        "stale": [],
        "cancelled": []
      }
    },
    "tool_dispatch": {
      "states": ["queued", "leased", "sending", "awaiting_receipt", "retry_wait", "succeeded", "failed", "cancelled", "uncertain", "dead_letter"],
      "terminal_states": ["succeeded", "failed", "cancelled", "uncertain", "dead_letter"],
      "transitions": {
        "queued": ["leased", "failed", "cancelled"],
        "leased": ["sending", "retry_wait", "failed", "cancelled", "dead_letter"],
        "sending": ["awaiting_receipt", "retry_wait", "succeeded", "failed", "cancelled", "uncertain", "dead_letter"],
        "awaiting_receipt": ["succeeded", "failed", "cancelled", "uncertain", "dead_letter"],
        "retry_wait": ["leased", "failed", "cancelled", "dead_letter"],
        "succeeded": [],
        "failed": [],
        "cancelled": [],
        "uncertain": [],
        "dead_letter": []
      }
    },
    "model_call": {
      "states": ["accepted", "leased", "sending", "retry_wait", "succeeded", "failed", "cancelled", "uncertain", "dead_letter"],
      "terminal_states": ["succeeded", "failed", "cancelled", "uncertain", "dead_letter"],
      "transitions": {
        "accepted": ["leased", "failed", "cancelled"],
        "leased": ["sending", "retry_wait", "failed", "cancelled", "dead_letter"],
        "sending": ["retry_wait", "succeeded", "failed", "cancelled", "uncertain", "dead_letter"],
        "retry_wait": ["leased", "failed", "cancelled", "dead_letter"],
        "succeeded": [],
        "failed": [],
        "cancelled": [],
        "uncertain": [],
        "dead_letter": []
      }
    }
  }
}
