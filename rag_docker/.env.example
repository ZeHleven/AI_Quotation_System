# Copy this file to /opt/rag_service/.env on CentOS and replace every
# replace-* value with the real deployment value. Do not commit .env.

# Exact private interface used for Windows-to-CentOS service traffic. Never
# use 0.0.0.0 or a public interface. Change this on cloud private networks.
INTERNAL_BIND_ADDRESS=192.168.88.128

# RAG reload API
RELOAD_SECRET=replace-with-strong-random-secret

# Milvus internal MinIO credentials. Milvus and the internal minio service
# must use the same pair. For an existing deployment, copy the currently active
# values before restarting the compose stack.
MILVUS_MINIO_ACCESS_KEY=replace-with-random-internal-user
MILVUS_MINIO_SECRET_KEY=replace-with-strong-random-password

# Quote attachment MinIO credentials.
QUOTE_MINIO_ROOT_USER=replace-with-random-admin-user
QUOTE_MINIO_ROOT_PASSWORD=replace-with-strong-random-password

# Backup script configuration. Fill these when MySQL backups are required.
MYSQL_CONTAINER=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
N8N_CONTAINER=n8n
BACKUP_ROOT=/opt/rag_service/backups
BACKUP_INCLUDE_ENV=false
