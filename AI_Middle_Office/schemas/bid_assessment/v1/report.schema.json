{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/report.schema.json",
  "title": "Bid Assessment Report Contracts v1",
  "description": "Immutable published report, claim, citation and delta contracts derived from master spec sections 5.6 and 14.",
  "$defs": {
    "ClaimType": {
      "type": "string",
      "enum": ["fact", "calculation", "inference", "recommendation"]
    },
    "ClaimSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_type", "support_id"],
      "properties": {
        "support_type": {
          "type": "string",
          "enum": ["resolved_fact", "coverage_state", "calculation", "finding", "gate", "dimension"]
        },
        "support_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "formula_version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "evidence_id", "locator_snapshot", "quote_hash", "display_label"],
      "properties": {
        "citation_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "evidence_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "locator_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_version_id", "locator_type", "locator"],
          "properties": {
            "document_version_id": {"$ref": "contracts.schema.json#/$defs/Id"},
            "locator_type": {"type": "string", "enum": ["page", "section", "paragraph", "sheet_range", "image_region"]},
            "locator": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        },
        "quote_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "display_label": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "text", "impact", "supports", "citations", "claim_hash"],
      "properties": {
        "claim_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "claim_type": {"$ref": "#/$defs/ClaimType"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "impact": {"type": "string", "enum": ["high", "medium", "low"]},
        "supports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/ClaimSupport"}
        },
        "citations": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/Citation"}
        },
        "inference_premise": {"type": ["string", "null"], "maxLength": 1000},
        "trigger_condition": {"type": ["string", "null"], "maxLength": 1000},
        "claim_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"claim_type": {"const": "fact"}}, "required": ["claim_type"]},
          "then": {
            "properties": {
              "supports": {"contains": {"properties": {"support_type": {"const": "resolved_fact"}}, "required": ["support_type"]}},
              "citations": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"claim_type": {"const": "calculation"}}, "required": ["claim_type"]},
          "then": {
            "properties": {
              "supports": {"contains": {"properties": {"support_type": {"const": "calculation"}}, "required": ["support_type"]}}
            }
          }
        },
        {
          "if": {"properties": {"claim_type": {"const": "inference"}}, "required": ["claim_type"]},
          "then": {
            "required": ["inference_premise"],
            "properties": {
              "inference_premise": {"type": "string", "minLength": 1, "maxLength": 1000},
              "supports": {
                "contains": {
                  "properties": {"support_type": {"enum": ["resolved_fact", "calculation", "finding"]}},
                  "required": ["support_type"]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"claim_type": {"const": "recommendation"}}, "required": ["claim_type"]},
          "then": {
            "required": ["trigger_condition"],
            "properties": {
              "trigger_condition": {"type": "string", "minLength": 1, "maxLength": 1000},
              "supports": {
                "contains": {
                  "properties": {"support_type": {"enum": ["finding", "gate", "dimension"]}},
                  "required": ["support_type"]
                }
              }
            }
          }
        }
      ]
    },
    "ReportSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_code", "order_no", "title", "claims", "section_hash"],
      "properties": {
        "section_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "order_no": {"type": "integer", "minimum": 1, "maximum": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "claims": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/Claim"}
        },
        "section_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"}
      }
    },
    "ReportScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lot_id", "lot_name"],
      "properties": {
        "lot_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "lot_name": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "ReportQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_validation", "coverage", "unknown_count", "conflict_count"],
      "properties": {
        "claim_validation": {"type": "string", "enum": ["passed", "partial", "failed"]},
        "coverage": {"$ref": "contracts.schema.json#/$defs/RatioDecimalString"},
        "unknown_count": {"type": "integer", "minimum": 0},
        "conflict_count": {"type": "integer", "minimum": 0}
      }
    },
    "PublishedReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "report_type",
        "report_version",
        "status",
        "assessment_id",
        "analysis_run_id",
        "scope",
        "bound_versions",
        "decision",
        "sections",
        "quality",
        "input_hash",
        "published_at"
      ],
      "properties": {
        "report_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "report_type": {"type": "string", "enum": ["preliminary", "deep"]},
        "report_version": {"type": "integer", "minimum": 1},
        "status": {"const": "published"},
        "assessment_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "analysis_run_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "scope": {"$ref": "#/$defs/ReportScope"},
        "bound_versions": {"$ref": "contracts.schema.json#/$defs/VersionBinding"},
        "decision": {"$ref": "decision.schema.json#/$defs/DecisionResult"},
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {"$ref": "#/$defs/ReportSection"}
        },
        "quality": {"$ref": "#/$defs/ReportQuality"},
        "input_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "published_at": {"$ref": "contracts.schema.json#/$defs/UtcDateTime"}
      }
    },
    "ReportDeltaChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_type", "path", "summary", "severity"],
      "properties": {
        "change_type": {"type": "string", "enum": ["added", "removed", "changed", "resolved", "stale"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "informational"]}
      }
    },
    "ReportDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_id", "from_report_id", "to_report_id", "severity", "changes", "summary", "input_hash"],
      "properties": {
        "delta_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "from_report_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "to_report_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "informational"]},
        "changes": {
          "type": "array",
          "maxItems": 500,
          "items": {"$ref": "#/$defs/ReportDeltaChange"}
        },
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "input_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/PublishedReport"},
    {"$ref": "#/$defs/ReportDelta"}
  ]
}
