{
  "schema": "bid-assessment-phase4d2-enterprise-evidence-import-profile-v1",
  "profile_id": "bid-assessment-phase4d2-enterprise-evidence-import-v1",
  "source_spec_version": "v0.1-r60",
  "status": "locally_validated_pending_real_enterprise_data",
  "requires": [
    "contracts/bid_assessment/v1/phase4d1-business-baseline-revalidation-profile.json",
    "schemas/bid_assessment/v1/enterprise-evidence-import.schema.json",
    "schemas/bid_assessment/v1/enterprise-business-baseline.schema.json"
  ],
  "evidence_item": {
    "schema": "bid.enterprise.evidence-item.v1",
    "accepted_extensions": ["pdf", "docx", "xlsx", "xlsm", "png", "jpg", "jpeg", "txt", "md"],
    "content_addressed": true,
    "sha256_required": true,
    "explicit_source_identity_required": true,
    "object_ref_server_only": true,
    "filename_or_mime_slot_inference_forbidden": true,
    "ocr_visual_embedding_model_calls": false
  },
  "evidence_package": {
    "schema": "bid.enterprise.evidence-package.v1",
    "validation_schema": "bid.enterprise.evidence-package-validation.v1",
    "slot_set": ["I01", "I02", "I03", "I04", "I05", "I06", "I07", "I08", "I09", "I10", "I11"],
    "mapping_policy": "explicit_human_mapping_only",
    "at_least_one_evidence_item_required": true,
    "unmapped_slot_policy": "explicit_unknown_note",
    "candidate_hash_stable": true,
    "immutable": true
  },
  "business_baseline_binding": {
    "evidence_package_required_when_enabled": true,
    "file_evidence_classes": ["official_document", "internal_system", "audited_record"],
    "item_must_belong_to_same_package_and_slot": true,
    "class_reference_hash_and_validity_must_match": true,
    "unknown_forbids_evidence_item": true,
    "baseline_hash_binds_package_hash": true
  },
  "run_and_release_binding": {
    "run_input_fingerprint_binds": [
      "enterprise_evidence_package_version",
      "enterprise_evidence_package_hash"
    ],
    "run_bootstrap_rechecks_item_validity": true,
    "release_candidate_source_hashes_bind_package_hash": true
  },
  "runtime_lab": {
    "upload_path": "/api/v1/bid-assessment-runtime-lab/enterprise-evidence-items",
    "package_validate_path": "/api/v1/bid-assessment-runtime-lab/enterprise-evidence-packages/validate",
    "package_freeze_path": "/api/v1/bid-assessment-runtime-lab/enterprise-evidence-packages",
    "local_execute_admin_only": true,
    "view_only_writes_blocked_server_side": true,
    "idempotency_required": true,
    "candidate_hash_header": "X-Enterprise-Evidence-Candidate-Hash"
  },
  "compatibility": {
    "new_database_migration_required": true,
    "alembic_head": "20260817_0107",
    "new_tables": [
      "bid_enterprise_evidence_items",
      "bid_enterprise_evidence_packages",
      "bid_enterprise_evidence_package_items"
    ],
    "legacy_bid_intake_modified": false,
    "feature_flag": "FEATURE_BID_ASSESSMENT_PHASE4_ENTERPRISE_EVIDENCE_IMPORT",
    "feature_flag_default": false,
    "ecs_rollout_allowed": false
  }
}
