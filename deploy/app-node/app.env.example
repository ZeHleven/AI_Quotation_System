# This is a template only. Never place the real file in the repository or the
# Docker build context. On ECS the real file belongs at:
#   /etc/ai-middle-office/app.env  (root:root, mode 0600)

APP_NAME=Enterprise AI Middle Office
APP_ENV=production
STRICT_CONFIG=true
LOG_LEVEL=INFO

# Keep the first ECS deployment dark until TLS/WAF and all private services pass.
PUBLIC_ACCESS_ENABLED=false
ALLOW_SELF_REGISTRATION=false
CORS_ALLOW_ORIGINS=https://www.qskingship.com
TRUSTED_HOSTS=www.qskingship.com,localhost,127.0.0.1

AUTO_CREATE_TABLES=false
STARTUP_COMPAT_MIGRATIONS=false
AUTO_RUN_DB_MIGRATIONS=false
DATABASE_URL=mysql+pymysql://REPLACE_RUNTIME_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_DB_HOST:3306/REPLACE_DATABASE?charset=utf8mb4&ssl_ca=/run/secrets/mysql-ca.pem&ssl_check_hostname=false
MIGRATION_DATABASE_URL=mysql+pymysql://REPLACE_MIGRATOR_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_DB_HOST:3306/REPLACE_DATABASE?charset=utf8mb4&ssl_ca=/run/secrets/mysql-ca.pem&ssl_check_hostname=false
DATABASE_STARTUP_WAIT_SECONDS=120
DATABASE_STARTUP_RETRY_INTERVAL_SECONDS=3

JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RELOAD_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ZHIPU_API_KEY=REPLACE_WITH_REAL_KEY

FEATURE_VITE_FRONTEND=true
# Keep the autonomous daily scheduler disabled while the dark ECS runtime
# overlaps with the existing Windows runtime. Manual Agent functions remain
# available and this does not disable the Celery quote worker.
FEATURE_AGENT_ASSISTANTS=true
FEATURE_AGENT_DAILY_REVIEW=false
TASK_QUEUE_MODE=celery
CELERY_BROKER_URL=redis://REPLACE_PRIVATE_REDIS_HOST:6380/0
CELERY_RESULT_BACKEND=redis://REPLACE_PRIVATE_REDIS_HOST:6380/1
CELERY_WORKER_POOL=threads
CELERY_WORKER_CONCURRENCY=2

RAG_SERVICE_URL=http://REPLACE_PRIVATE_RAG_HOST:8001
N8N_WEBHOOK_URL_CALC=http://REPLACE_PRIVATE_N8N_HOST:5678/webhook/budget-calc-no-rag
N8N_WEBHOOK_URL_PUSH=http://REPLACE_PRIVATE_N8N_HOST:5678/webhook/budget-push
READY_CHECK_EXTERNAL_SERVICES=true

MINIO_ENABLED=true
MINIO_ENDPOINT=REPLACE_PRIVATE_MINIO_HOST:9002
MINIO_ACCESS_KEY=REPLACE_WITH_RANDOM_MINIO_USER
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_MINIO_PASSWORD
MINIO_SECURE=false
MINIO_BUCKET=quote-files

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,REPLACE_PRIVATE_NETWORK_OR_HOSTS

ALERT_DINGTALK_WEBHOOK=
ALERT_DINGTALK_SECRET=
