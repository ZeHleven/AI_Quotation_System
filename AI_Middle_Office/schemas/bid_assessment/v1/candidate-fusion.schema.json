{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/candidate-fusion.schema.json",
  "title": "Qisheng Bid Assessment RQ2-B Candidate Fusion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_version",
    "source_index_set_hash",
    "lexical_projection_set_hash",
    "semantic_index_set_hash",
    "query_plan_hash",
    "lexical_candidate_count",
    "semantic_candidate_count",
    "union_candidate_count",
    "overlap_candidate_count",
    "candidates",
    "result_hash"
  ],
  "properties": {
    "contract_version": {"const": "bid.evidence.candidate-fusion.v1"},
    "profile_version": {"const": "bid-evidence-candidate-fusion-profile-v1-rq2b"},
    "source_index_set_hash": {"$ref": "#/$defs/Sha256"},
    "lexical_projection_set_hash": {"$ref": "#/$defs/Sha256"},
    "semantic_index_set_hash": {"$ref": "#/$defs/Sha256"},
    "query_plan_hash": {"$ref": "#/$defs/Sha256"},
    "lexical_candidate_count": {"type": "integer", "minimum": 0, "maximum": 40},
    "semantic_candidate_count": {"type": "integer", "minimum": 0, "maximum": 40},
    "union_candidate_count": {"type": "integer", "minimum": 0, "maximum": 80},
    "overlap_candidate_count": {"type": "integer", "minimum": 0, "maximum": 40},
    "candidates": {
      "type": "array",
      "maxItems": 80,
      "items": {"$ref": "#/$defs/FusedCandidate"}
    },
    "result_hash": {"$ref": "#/$defs/Sha256"}
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "EvidenceKey": {"type": "string", "pattern": "^(child|chunk):[a-f0-9]{64}$"},
    "FusedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_key",
        "fusion_score",
        "lexical_rank",
        "semantic_rank",
        "lexical_source_score",
        "semantic_source_score",
        "matched_channels"
      ],
      "properties": {
        "child_key": {"$ref": "#/$defs/EvidenceKey"},
        "fusion_score": {"type": "number", "minimum": 0},
        "lexical_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 40},
        "semantic_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 40},
        "lexical_source_score": {"type": ["number", "null"]},
        "semantic_source_score": {"type": ["number", "null"]},
        "matched_channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["lexical_bm25f", "semantic_bce"]}
        }
      }
    }
  }
}
