APP_NAME=Enterprise AI Middle Office
APP_VERSION=1.0.0
APP_ENV=development
STRICT_CONFIG=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./sql_app.db
# Production: use a separate, source-restricted account with only Alembic DDL/DML privileges.
# Leave empty only for local SQLite compatibility; public mode rejects a missing/shared value.
MIGRATION_DATABASE_URL=
DATABASE_STARTUP_WAIT_SECONDS=120
DATABASE_STARTUP_RETRY_INTERVAL_SECONDS=3
# Production should rely on Alembic. For a brand-new local SQLite sandbox, you may set these to true temporarily.
AUTO_CREATE_TABLES=false
STARTUP_COMPAT_MIGRATIONS=false
AUTO_RUN_DB_MIGRATIONS=true
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SYSTEM_ADMIN_USERNAME=admin
FEATURE_VITE_FRONTEND=false
FEATURE_UNIFIED_QUOTES=false
FEATURE_ENTERPRISE_QUOTA_V2_REVIEW=false
