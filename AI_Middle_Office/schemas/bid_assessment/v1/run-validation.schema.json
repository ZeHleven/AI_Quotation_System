{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/run-validation.schema.json",
  "title": "Qisheng Bid Assessment Run Validation/Convergence Contracts v1",
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "RunValidationStatus": {
      "enum": ["requested", "leased", "running", "passed", "failed", "stale", "cancelled"]
    },
    "RunValidationOutcome": {"enum": ["passed", "failed", "stale"]},
    "RunValidationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed", "severity", "detail"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,96}$"},
        "passed": {"type": "boolean"},
        "severity": {"enum": ["fatal", "warning"]},
        "detail": {}
      }
    },
    "RunValidationClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "run_id", "attempt_id", "attempt_no", "fencing_token", "worker_id", "lease_until"],
      "properties": {
        "validation_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "attempt_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "attempt_no": {"type": "integer", "minimum": 1},
        "fencing_token": {"type": "integer", "minimum": 1},
        "worker_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lease_until": {"type": "string", "format": "date-time", "pattern": "Z$"}
      }
    },
    "RunValidationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "validator_version", "validation_id", "run_id", "outcome", "retryable", "failure_code", "run_input_hash", "validation_input_hash", "checks", "summary", "result_hash"],
      "properties": {
        "schema": {"const": "bid.run.validation.result.v1"},
        "validator_version": {"type": "string", "enum": ["bid-run-integrity-validator-v2", "bid-run-integrity-validator-v3", "bid-run-integrity-validator-v4"]},
        "validation_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "outcome": {"$ref": "#/$defs/RunValidationOutcome"},
        "retryable": {"type": "boolean"},
        "failure_code": {"type": ["string", "null"], "pattern": "^BID_[A-Z0-9_]{2,96}$"},
        "run_input_hash": {"$ref": "#/$defs/Sha256"},
        "validation_input_hash": {"$ref": "#/$defs/Sha256"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/RunValidationCheck"}},
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_count", "passed_count", "failed_count", "failed_codes"],
          "properties": {
            "check_count": {"type": "integer", "minimum": 1},
            "passed_count": {"type": "integer", "minimum": 0},
            "failed_count": {"type": "integer", "minimum": 0},
            "failed_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,96}$"}}
          }
        },
        "result_hash": {"$ref": "#/$defs/Sha256"}
      }
    }
  }
}
