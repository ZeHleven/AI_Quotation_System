# 只填写 MODEL_ID 时复用现有 DEEPSEEK_API_KEY、DEEPSEEK_CHAT_URL；
# 三项同时留空时也复用现有 DEEPSEEK_API_KEY、DEEPSEEK_CHAT_URL，
# 模型优先使用 BIDDING_LLM_MODEL，其次 DEEPSEEK_MODEL。
# 主模型出现余额、限流、超时或服务异常时，可自动切换备用模型。
# 成本优先、禁止自动切换时设置 BID_INTAKE_FALLBACK_ENABLED=false。
# 三项同时留空时，如已配置 ZHIPU_API_KEY + GLM_VISION_MODEL，
# 自动复用智谱 OpenAI-compatible 路由。
BID_INTAKE_FALLBACK_ENABLED=true
BID_INTAKE_FALLBACK_MODEL_API_URL=
