{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/query-plan.schema.json",
  "title": "Qisheng Bid Evidence Deterministic Query Plan v2",
  "$ref": "#/$defs/BidEvidenceQueryPlan",
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "QueryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "text",
        "kind",
        "weight",
        "field_codes",
        "answer_shapes",
        "reason_codes",
        "subject",
        "polarity"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^q[1-6]$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "original",
            "parallel_subject",
            "field_alias",
            "legacy_atomic",
            "legacy_fact_slot",
            "semantic_companion"
          ]
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "field_codes": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          }
        },
        "answer_shapes": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          }
        },
        "subject": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 30
        },
        "polarity": {
          "enum": ["neutral", "include", "exclude", "negative_outcome"]
        }
      }
    },
    "BidEvidenceQueryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_version",
        "strategy",
        "original_query",
        "queries",
        "query_items",
        "query_count",
        "expansion_count",
        "query_budget",
        "detected_field_codes",
        "detected_subjects",
        "legacy_planner_profile_version",
        "legacy_strategy",
        "clarification_required",
        "warnings",
        "plan_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "bid.evidence.query-plan.v2"
        },
        "profile_version": {
          "const": "bid-evidence-query-optimizer-profile-v1-rq1c"
        },
        "strategy": {
          "const": "bounded_field_and_subject_expansion"
        },
        "original_query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "query_items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/QueryItem"
          }
        },
        "query_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "expansion_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "query_budget": {
          "const": 6
        },
        "detected_field_codes": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          }
        },
        "detected_subjects": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          }
        },
        "legacy_planner_profile_version": {
          "const": "tender-query-planner-v1"
        },
        "legacy_strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "clarification_required": {
          "const": false
        },
        "warnings": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NO_TENDER_FIELD_ALIAS_MATCH",
              "QUERY_EXPANSION_BUDGET_REACHED"
            ]
          }
        },
        "plan_hash": {
          "$ref": "#/$defs/Hash"
        }
      }
    }
  }
}
