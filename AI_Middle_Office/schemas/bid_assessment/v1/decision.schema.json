{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/decision.schema.json",
  "title": "Bid Assessment Decision Result v1",
  "description": "Deterministic decision output and compatibility matrix derived from master spec section 13.",
  "$defs": {
    "ScoreDecimalString": {
      "type": "string",
      "pattern": "^(100(\\.0{1,6})?|(0|[1-9][0-9]?)(\\.[0-9]{1,6})?)$"
    },
    "VerificationCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["person_days", "amount", "currency"],
      "properties": {
        "person_days": {"$ref": "contracts.schema.json#/$defs/NonnegativeDecimalString"},
        "amount": {"$ref": "contracts.schema.json#/$defs/MoneyDecimalString"},
        "currency": {"const": "CNY"}
      }
    },
    "DecisionCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "statement",
        "owner",
        "deadline",
        "verification_source",
        "estimated_verification_cost",
        "pass_effect",
        "fail_effect"
      ],
      "properties": {
        "condition_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 500},
        "owner": {"type": "string", "enum": ["enterprise", "client_confirmation"]},
        "deadline": {
          "oneOf": [
            {"$ref": "contracts.schema.json#/$defs/UtcDateTime"},
            {"type": "null"}
          ]
        },
        "verification_source": {"type": "string", "minLength": 1, "maxLength": 500},
        "estimated_verification_cost": {"$ref": "#/$defs/VerificationCost"},
        "pass_effect": {"type": "string", "minLength": 1, "maxLength": 500},
        "fail_effect": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "DecisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "analysis_run_id",
        "decision_class",
        "investment_level",
        "known_score",
        "known_weight",
        "coverage",
        "information_quality",
        "conditions",
        "rule_version",
        "bound_versions",
        "input_hash"
      ],
      "properties": {
        "decision_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "analysis_run_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "decision_class": {"$ref": "contracts.schema.json#/$defs/DecisionClass"},
        "investment_level": {"$ref": "contracts.schema.json#/$defs/InvestmentLevel"},
        "known_score": {
          "oneOf": [
            {"$ref": "#/$defs/ScoreDecimalString"},
            {"type": "null"}
          ]
        },
        "known_weight": {"$ref": "contracts.schema.json#/$defs/RatioDecimalString"},
        "coverage": {"$ref": "contracts.schema.json#/$defs/RatioDecimalString"},
        "information_quality": {"type": "string", "enum": ["strong", "adequate", "weak", "insufficient"]},
        "conditions": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/DecisionCondition"}
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$"}
        },
        "rule_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "bound_versions": {"$ref": "contracts.schema.json#/$defs/VersionBinding"},
        "input_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"}
      },
      "allOf": [
        {
          "anyOf": [
            {"properties": {"decision_class": {"const": "recommend"}, "investment_level": {"const": "limited"}}, "required": ["decision_class", "investment_level"]},
            {"properties": {"decision_class": {"const": "recommend"}, "investment_level": {"const": "full"}}, "required": ["decision_class", "investment_level"]},
            {"properties": {"decision_class": {"const": "conditional"}, "investment_level": {"const": "low_cost_verification"}}, "required": ["decision_class", "investment_level"]},
            {"properties": {"decision_class": {"const": "conditional"}, "investment_level": {"const": "limited"}}, "required": ["decision_class", "investment_level"]},
            {"properties": {"decision_class": {"const": "not_recommend"}, "investment_level": {"const": "stop"}}, "required": ["decision_class", "investment_level"]},
            {"properties": {"decision_class": {"const": "not_recommend"}, "investment_level": {"const": "low_cost_verification"}}, "required": ["decision_class", "investment_level"]},
            {"properties": {"decision_class": {"const": "insufficient"}, "investment_level": {"const": "stop"}}, "required": ["decision_class", "investment_level"]},
            {"properties": {"decision_class": {"const": "insufficient"}, "investment_level": {"const": "low_cost_verification"}}, "required": ["decision_class", "investment_level"]}
          ]
        }
      ]
    }
  },
  "$ref": "#/$defs/DecisionResult"
}
