APP_NAME=Enterprise AI Middle Office
APP_VERSION=1.0.0
APP_ENV=development
STRICT_CONFIG=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./sql_app.db
DATABASE_STARTUP_WAIT_SECONDS=120
DATABASE_STARTUP_RETRY_INTERVAL_SECONDS=3
# Production should rely on Alembic. For a brand-new local SQLite sandbox, you may set these to true temporarily.
AUTO_CREATE_TABLES=false
STARTUP_COMPAT_MIGRATIONS=false
AUTO_RUN_DB_MIGRATIONS=true
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SYSTEM_ADMIN_USERNAME=admin
FEATURE_VITE_FRONTEND=false
FEATURE_DASHBOARD_QUOTE=false
PUBLIC_ACCESS_ENABLED=false

ZHIPU_API_KEY=
WEBHOOK_SECRET=
RELOAD_SECRET=
N8N_WEBHOOK_URL_CALC=http://192.168.88.128:5678/webhook/budget-calc
N8N_WEBHOOK_URL_PUSH=http://192.168.88.128:5678/webhook/budget-push
RAG_SERVICE_URL=http://192.168.88.128:8001
DIFY_APP_VERSION=
DIFY_WORKFLOW_VERSION=
DIFY_PROMPT_VERSION=
DIFY_RELEASE_ID=
RAG_COLLECTION_ALIAS=enterprise_quotation_rag
TASK_QUEUE_MODE=local
CELERY_BROKER_URL=redis://192.168.88.128:6380/0
CELERY_RESULT_BACKEND=redis://192.168.88.128:6380/1
QUOTE_TASK_TIME_LIMIT_SECONDS=240
QUEUE_HEALTH_TIMEOUT_SECONDS=1.5
OPS_PROBE_TIMEOUT_SECONDS=2
OPS_STUCK_JOB_MINUTES=30
OPS_LOG_SCAN_LINES=800
OPS_LOG_MAX_FILES=6
OPS_LOG_LOOKBACK_MINUTES=180
# 运维告警推送（留空则静默不推送）
ALERT_DINGTALK_WEBHOOK=
ALERT_DEDUP_MINUTES=30
ALERT_RATE_LIMIT_COUNT=3
ALERT_RATE_LIMIT_WINDOW_MINUTES=5
ALERT_CHECK_INTERVAL_SECONDS=60
GLM_VISION_MODEL=glm-4v-flash
GLM_VISION_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
MODEL_GATEWAY_TIMEOUT_SECONDS=20
MODEL_GATEWAY_FAILURE_THRESHOLD=3
MODEL_GATEWAY_CIRCUIT_RESET_SECONDS=60
MODEL_GATEWAY_COST_PER_1K_CHARS=0.0
MINIO_ENABLED=false
MINIO_ENDPOINT=192.168.88.128:9002
MINIO_ACCESS_KEY=quoteadmin
MINIO_SECRET_KEY=change-this-password
MINIO_SECURE=false
MINIO_BUCKET=quote-files
MINIO_PRESIGNED_EXPIRE_SECONDS=3600
MINIO_MAX_UPLOAD_MB=50
# RAG 检索质量评测（热更新后自动触发）
RAG_EVAL_ENABLED=true
RAG_EVAL_TOP_K=5
RAG_EVAL_WARN_HIT_RATE=0.70
RAG_EVAL_WARN_MRR=0.50
RAG_EVAL_REPORT_DIR=
# 登录接口限流（每 IP 每时间窗口最多 N 次，Redis 不可用时自动降级为内存）
LOGIN_RATE_LIMIT=10/5minutes

HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NO_PROXY=192.168.88.128,192.168.0.0/16,192.168.88.0/24,localhost,127.0.0.1,127.0.0.0/8
CORS_ALLOW_ORIGINS=*
# Main material storage is the database. This file is only the legacy JSON import source.
LEGACY_MATERIALS_FILE=
# Backward-compatible alias for older deployments. Prefer LEGACY_MATERIALS_FILE for new env files.
MATERIALS_FILE=
