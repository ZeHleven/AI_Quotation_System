{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/context.schema.json",
  "title": "Bid Assessment Context Manifest v1",
  "description": "Reproducible model-call context boundary derived from master spec section 11.3.",
  "$defs": {
    "ModelRole": {
      "type": "string",
      "enum": ["planner", "local_research", "synthesizer", "evidence_validator", "report_writer"]
    },
    "IncludedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chars", "priority"],
      "properties": {
        "id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "chars": {"type": "integer", "minimum": 0, "maximum": 12000},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"]}
      }
    },
    "BudgetExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_id", "priority", "reason"],
      "properties": {
        "resource_type": {"type": "string", "enum": ["fact", "calculation", "evidence", "dependency_output", "working_state"]},
        "resource_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "priority": {"type": "string", "enum": ["P2", "P3", "P4"]},
        "reason": {"const": "token_budget"}
      }
    },
    "ContextManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_manifest_id",
        "task_id",
        "task_attempt_id",
        "fencing_token",
        "role",
        "bound_versions",
        "included_fact_ids",
        "included_calculation_ids",
        "included_evidence",
        "dependency_output_ids",
        "excluded_due_to_budget",
        "token_estimate",
        "compression_level",
        "assembler_version",
        "task_contract_hash",
        "context_profile",
        "budget_profile",
        "included_tool_result_ids",
        "included_model_result_ids",
        "working_state_hash",
        "component_token_estimates",
        "hash"
      ],
      "properties": {
        "context_manifest_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "task_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "task_attempt_id": {"$ref": "contracts.schema.json#/$defs/Id"},
        "fencing_token": {"type": "integer", "minimum": 1},
        "role": {"$ref": "#/$defs/ModelRole"},
        "bound_versions": {"$ref": "contracts.schema.json#/$defs/VersionBinding"},
        "included_fact_ids": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "included_gate_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "included_calculation_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "included_evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/IncludedEvidence"}
        },
        "dependency_output_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "excluded_due_to_budget": {
          "type": "array",
          "maxItems": 500,
          "items": {"$ref": "#/$defs/BudgetExclusion"}
        },
        "token_estimate": {"type": "integer", "minimum": 0, "maximum": 32000},
        "compression_level": {"type": "integer", "minimum": 0, "maximum": 3},
        "assembler_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "task_contract_hash": {"$ref": "contracts.schema.json#/$defs/Sha256"},
        "context_profile": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "budget_profile": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "included_tool_result_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "included_model_result_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "working_state_hash": {
          "oneOf": [
            {"$ref": "contracts.schema.json#/$defs/Sha256"},
            {"type": "null"}
          ]
        },
        "component_token_estimates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "evidence", "total"],
          "properties": {
            "base": {"type": "integer", "minimum": 0, "maximum": 32000},
            "evidence": {"type": "integer", "minimum": 0, "maximum": 32000},
            "total": {"type": "integer", "minimum": 0, "maximum": 32000}
          }
        },
        "hash": {"$ref": "contracts.schema.json#/$defs/Sha256"}
      }
    }
  },
  "$ref": "#/$defs/ContextManifest"
}
