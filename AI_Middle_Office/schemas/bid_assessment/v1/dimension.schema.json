{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qisheng.local/schemas/bid-assessment/v1/dimension.schema.json",
  "title": "Bid Assessment Dimension Result v1",
  "description": "Seven-dimension output contract derived from master spec section 6.",
  "$defs": {
    "DimensionCode": {
      "type": "string",
      "enum": [
        "qualification_compliance",
        "win_probability",
        "project_economics",
        "bid_investment",
        "contract_delivery_risk",
        "capability_fit",
        "customer_strategy"
      ]
    },
    "DimensionRating": {
      "type": "string",
      "enum": ["strong_positive", "positive", "neutral", "negative", "strong_negative", "unknown"]
    },
    "DimensionSufficiency": {
      "type": "string",
      "enum": ["sufficient", "usable", "insufficient", "conflicted"]
    },
    "DimensionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_code",
        "rating",
        "score",
        "sufficiency",
        "coverage",
        "positive_findings",
        "negative_findings",
        "unknown_fact_slots",
        "conditions",
        "summary_claim_id"
      ],
      "properties": {
        "dimension_code": {"$ref": "#/$defs/DimensionCode"},
        "rating": {"$ref": "#/$defs/DimensionRating"},
        "score": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 100},
            {"type": "null"}
          ]
        },
        "sufficiency": {"$ref": "#/$defs/DimensionSufficiency"},
        "coverage": {"$ref": "contracts.schema.json#/$defs/RatioDecimalString"},
        "positive_findings": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "negative_findings": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "unknown_fact_slots": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "conditions": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "contracts.schema.json#/$defs/Id"}
        },
        "summary_claim_id": {
          "oneOf": [
            {"$ref": "contracts.schema.json#/$defs/Id"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"rating": {"const": "unknown"}}, "required": ["rating"]},
          "then": {"properties": {"score": {"type": "null"}}},
          "else": {"properties": {"score": {"type": "integer", "minimum": 0, "maximum": 100}}}
        },
        {
          "if": {"properties": {"rating": {"const": "strong_positive"}}, "required": ["rating"]},
          "then": {"properties": {"score": {"const": 100}}}
        },
        {
          "if": {"properties": {"rating": {"const": "positive"}}, "required": ["rating"]},
          "then": {"properties": {"score": {"const": 75}}}
        },
        {
          "if": {"properties": {"rating": {"const": "neutral"}}, "required": ["rating"]},
          "then": {"properties": {"score": {"const": 50}}}
        },
        {
          "if": {"properties": {"rating": {"const": "negative"}}, "required": ["rating"]},
          "then": {"properties": {"score": {"const": 25}}}
        },
        {
          "if": {"properties": {"rating": {"const": "strong_negative"}}, "required": ["rating"]},
          "then": {"properties": {"score": {"const": 0}}}
        }
      ]
    }
  },
  "$ref": "#/$defs/DimensionResult"
}
